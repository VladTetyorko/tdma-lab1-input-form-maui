<?xml version="1.0" encoding="UTF-8"?>

<!-- A modal drawer on every device (no side panel, no tabs). The sign-in page is declared here and switches the drawer
     off; The root pages are added in code. The drawer content is Views/Components/DrawerContent -->
<Shell
    x:Class="Mobile_apps_L1_Model_view.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
    Title="StockRoom"
    FlyoutBehavior="Flyout"
    FlyoutBackdrop="{DynamicResource OverlayBrush}">

    <ShellContent
        Title="Sign in"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

</Shell>
