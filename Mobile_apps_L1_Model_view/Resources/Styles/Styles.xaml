                            <Setter Property="TextColor" Value="{DynamicResource TextDisabled}" />
                            <Setter Property="BorderColor" Value="{DynamicResource Border}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

