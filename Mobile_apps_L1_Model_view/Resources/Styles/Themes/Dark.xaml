<?xml version="1.0" encoding="UTF-8"?>

<!-- Dark theme, deep dark and violet: the semantic keys of docs/design/design-system.md section 3 (same keys in every theme dictionary).
     The only place with raw hex values; the comment names the palette primitive. A Color element cannot alias another resource in MAUI XAML. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Mobile_apps_L1_Model_view.Resources.Styles.Themes.Dark">

    <Color x:Key="Background">#121018</Color>  <!-- background -->
    <Color x:Key="Surface">#1B1824</Color>  <!-- surface -->
    <Color x:Key="SurfaceAlt">#24202F</Color>  <!-- surface alt -->
    <Color x:Key="Border">#342E42</Color>  <!-- border -->
    <Color x:Key="BorderStrong">#6E6582</Color>  <!-- border strong -->
    <Color x:Key="TextPrimary">#ECE9F2</Color>  <!-- text -->
    <Color x:Key="TextSecondary">#A9A2B8</Color>  <!-- text secondary -->
    <Color x:Key="TextDisabled">#6B6478</Color>  <!-- text disabled -->
    <Color x:Key="Primary">#6D4FD1</Color>  <!-- Violet600 -->
    <Color x:Key="PrimaryHover">#5E41BF</Color>  <!-- Violet700 -->
    <Color x:Key="PrimaryPressed">#5E41BF</Color>  <!-- Violet700 -->
    <Color x:Key="PrimarySoft">#2B2342</Color>  <!-- Violet900 -->
    <Color x:Key="OnPrimary">#FFFFFF</Color>  <!-- white -->
    <Color x:Key="PrimaryText">#B49CFF</Color>  <!-- Violet300 -->
    <Color x:Key="ChipSuccessText">#B49CFF</Color>  <!-- Violet300 -->
    <Color x:Key="Danger">#FF8A85</Color>  <!-- danger -->
    <Color x:Key="DangerSoft">#3A1C22</Color>  <!-- danger soft -->
    <Color x:Key="OnDanger">#121018</Color>  <!-- background -->
    <Color x:Key="Warning">#F5B95A</Color>  <!-- warning -->
    <Color x:Key="WarningSoft">#3A2E17</Color>  <!-- warning soft -->
    <Color x:Key="Info">#8DB8F2</Color>  <!-- info -->
    <Color x:Key="Success">#6FD08F</Color>  <!-- success -->
    <Color x:Key="FocusRing">#B49CFF</Color>  <!-- Violet300 -->
    <Color x:Key="Overlay">#66000000</Color>  <!-- 40 % black scrim -->

    <!-- Brush-typed properties (Border.Stroke, Border.Background) need brushes; a DynamicResource colour is not converted -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoft}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}" />
</ResourceDictionary>
