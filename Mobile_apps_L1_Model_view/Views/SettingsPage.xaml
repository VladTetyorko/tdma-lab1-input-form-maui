<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels"
             x:Class="Mobile_apps_L1_Model_view.Views.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="8">
            <Label Text="Theme" Style="{StaticResource SectionLabel}" />
            <Label Text="System follows the device setting." Style="{StaticResource CaptionLabel}" />
            <Picker ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />

            <Label Text="Open a link" Style="{StaticResource SectionLabel}" />
            <Label Text="Try a deep link without another app, e.g. stockroom://product/4820001000016"
                   Style="{StaticResource CaptionLabel}" />
            <Entry Text="{Binding LinkText, Mode=TwoWay}" Placeholder="stockroom://product/{barcode}" />
            <Button Text="Open" Command="{Binding OpenLinkCommand}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
