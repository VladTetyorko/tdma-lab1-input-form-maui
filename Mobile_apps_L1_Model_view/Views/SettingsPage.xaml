<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels"
             x:Class="Mobile_apps_L1_Model_view.Views.SettingsPage"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="8">
            <Label Text="Theme" Style="{StaticResource SectionLabel}" />
            <Label Text="System follows the device setting." Style="{StaticResource CaptionLabel}" />
            <Picker ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />

            <VerticalStackLayout IsVisible="{Binding IsBiometricSupported}" Spacing="8">
                <Label Text="Security" Style="{StaticResource SectionLabel}" />
                <Label Text="With biometric unlock on, the app asks for your fingerprint (or face) after a restart instead of opening straight away. The password always works."
                       Style="{StaticResource CaptionLabel}" />
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Biometric unlock" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding BiometricUnlock, Mode=TwoWay}" VerticalOptions="Center"
                            AutomationId="BiometricUnlockSwitch" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="Synchronisation" Style="{StaticResource SectionLabel}" />
            <Label Text="Changes are saved on this device first and sent to the server when a network is available."
                   Style="{StaticResource CaptionLabel}" />
            <Label Text="{Binding NetworkText, StringFormat='Network: {0}'}" />
            <Label Text="{Binding PendingCount, StringFormat='Waiting to be sent: {0}'}" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Label Text="Simulate offline" VerticalOptions="Center" />
                <Switch IsToggled="{Binding SimulateOffline, Mode=TwoWay}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="Sync now" Command="{Binding SyncNowCommand}" HorizontalOptions="Start" />
            <Label Text="{Binding SyncText}" Style="{StaticResource CaptionLabel}" />

            <Label Text="Database" Style="{StaticResource SectionLabel}" />
            <Label Text="Share the SQLite file (stockroom.db3) to open it on a PC. Counterparty names are encrypted in it."
                   Style="{StaticResource CaptionLabel}" />
            <Button Text="Share database" Command="{Binding ShareDatabaseCommand}" HorizontalOptions="Start" />
            <Label Text="{Binding ExportText}" Style="{StaticResource CaptionLabel}" />

            <VerticalStackLayout IsVisible="{Binding ShowDiagnostics}" Spacing="8">
                <Label Text="Diagnostics" Style="{StaticResource SectionLabel}" />
                <Label Text="Prove that logging and crash reporting work. Each button leaves a trace in the log."
                       Style="{StaticResource CaptionLabel}" />
                <Button Text="Open logs" Command="{Binding OpenLogsCommand}" HorizontalOptions="Start"
                        AutomationId="OpenLogsButton" />
                <Button Text="Write test log entries" Command="{Binding WriteTestEntriesCommand}" HorizontalOptions="Start"
                        AutomationId="WriteTestEntriesButton" />
                <Button Text="Throw in background task" Command="{Binding ThrowInBackgroundTaskCommand}" HorizontalOptions="Start"
                        AutomationId="ThrowInBackgroundButton" />
                <Button Text="Send test crash" Command="{Binding SendTestCrashCommand}" HorizontalOptions="Start"
                        IsEnabled="{Binding CanSendTestCrash}" AutomationId="SendTestCrashButton" />
                <Label Text="{Binding DiagnosticsText}" Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>

            <Label Text="Open a link" Style="{StaticResource SectionLabel}" />
            <Label Text="Try a deep link without another app, e.g. stockroom://product/3017620422003"
                   Style="{StaticResource CaptionLabel}" />
            <Entry Text="{Binding LinkText, Mode=TwoWay}" Placeholder="stockroom://product/{barcode}" />
            <Button Text="Open" Command="{Binding OpenLinkCommand}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
