<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="Container">
        <components:AppBar Title="Settings" Route="settings" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{OnIdiom Default='24,8', Phone='16,8'}" Spacing="16" MaximumWidthRequest="720">
                <components:AccountSection />
                <Border StyleClass="SectionCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Appearance" Style="{StaticResource TextHeading}" />
                        <Label Text="Theme. System follows the device setting." Style="{StaticResource TextCaption}" />
                        <Picker ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                AutomationId="ThemePicker" />
                    </VerticalStackLayout>
                </Border>
                <Border StyleClass="SectionCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Scanning" Style="{StaticResource TextHeading}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Scan sound" Style="{StaticResource TextBody}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ScanSound, Mode=TwoWay}" VerticalOptions="Center"
                                    AutomationId="ScanSoundSwitch" />
                        </Grid>
                        <Label Text="A beep for an accepted scan, another for a refused one." Style="{StaticResource TextCaption}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Shake to scan" Style="{StaticResource TextBody}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShakeToScan, Mode=TwoWay}" VerticalOptions="Center" IsEnabled="{Binding IsShakeSupported}"
                                    AutomationId="ShakeToScanSwitch" />
                        </Grid>
                        <Label Text="Shake the device on the product list to open the scanner." Style="{StaticResource TextCaption}" />
                        <Label Text="This device has no accelerometer, so shaking is not available here." Style="{StaticResource TextCaption}" IsVisible="{Binding IsShakeUnsupported}" />
                    </VerticalStackLayout>
                </Border>
                <Grid IsVisible="{Binding IsBiometricSupported}">
                <Border StyleClass="SectionCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Security" Style="{StaticResource TextHeading}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Biometric unlock" Style="{StaticResource TextBody}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding BiometricUnlock, Mode=TwoWay}" VerticalOptions="Center"
                                    AutomationId="BiometricUnlockSwitch" />
                        </Grid>
                        <Label Text="With biometric unlock on, the app asks for your fingerprint (or face) after a restart instead of opening straight away. The password always works." Style="{StaticResource TextCaption}" />
                    </VerticalStackLayout>
                </Border>
                </Grid>
                <Border StyleClass="SectionCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Synchronisation" Style="{StaticResource TextHeading}" />
                        <Label Text="Changes are saved on this device first and sent to the server when a network is available." Style="{StaticResource TextCaption}" />
                        <Label Text="{Binding NetworkText, StringFormat='Network: {0}'}" />
                        <Label Text="{Binding PendingCount, StringFormat='Waiting to be sent: {0}'}"
                               Style="{StaticResource TextBodyStrong}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Simulate offline" Style="{StaticResource TextBody}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding SimulateOffline, Mode=TwoWay}" VerticalOptions="Center"
                                    AutomationId="SimulateOfflineSwitch" />
                        </Grid>
                        <Button StyleClass="Outlined" Text="Sync now" Command="{Binding SyncNowCommand}" AutomationId="SyncNowButton" />
                        <Label Text="{Binding SyncText}" Style="{StaticResource TextCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border StyleClass="SectionCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Database" Style="{StaticResource TextHeading}" />
                        <Label Text="Share the SQLite file (stockroom.db3) to open it on a PC. Counterparty names are encrypted in it." Style="{StaticResource TextCaption}" />
                        <Button StyleClass="Outlined" Text="Share database" Command="{Binding ShareDatabaseCommand}" AutomationId="ShareDatabaseButton" />
                        <Label Text="{Binding ExportText}" Style="{StaticResource TextCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Grid IsVisible="{Binding ShowDiagnostics}">
                <Border StyleClass="SectionCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Diagnostics" Style="{StaticResource TextHeading}" />
                        <Label Text="Prove that logging and crash reporting work. Each button leaves a trace in the log." Style="{StaticResource TextCaption}" />
                        <Button StyleClass="Outlined" Text="Open logs" Command="{Binding OpenLogsCommand}" AutomationId="OpenLogsButton" />
                        <Button StyleClass="Outlined" Text="Write test log entries" Command="{Binding WriteTestEntriesCommand}" AutomationId="WriteTestEntriesButton" />
                        <Button StyleClass="Outlined" Text="Throw in background task" Command="{Binding ThrowInBackgroundTaskCommand}" AutomationId="ThrowInBackgroundButton" />
                        <Button StyleClass="Outlined" Text="Send test crash" Command="{Binding SendTestCrashCommand}" AutomationId="SendTestCrashButton" IsEnabled="{Binding CanSendTestCrash}" />
                        <Label Text="{Binding DiagnosticsText}" Style="{StaticResource TextCaption}" />
                    </VerticalStackLayout>
                </Border>
                </Grid>
                <Border StyleClass="SectionCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Open a link" Style="{StaticResource TextHeading}" />
                        <Label Text="Try a deep link without another app, e.g. stockroom://product/3017620422003" Style="{StaticResource TextCaption}" />
                        <components:OutlinedField Placeholder="stockroom://product/{barcode}" EntryId="LinkEntry"
                                                  Text="{Binding LinkText, Mode=TwoWay}" />
                        <Button StyleClass="Outlined" Text="Open" Command="{Binding OpenLinkCommand}" AutomationId="OpenLinkButton" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
