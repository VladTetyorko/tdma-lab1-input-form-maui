<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.ScannerPage"
             x:DataType="viewModels:ScannerViewModel"
             Title="Scan barcode">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Default=24, Phone=16}" Spacing="8" MaximumWidthRequest="720">
            <views:CameraScannerView HeightRequest="280"
                                     IsVisible="{Binding IsCameraSupported}"
                                     IsActive="{Binding IsCameraActive}"
                                     DetectedCommand="{Binding BarcodeDetectedCommand}" />

            <Label Text="Camera scanning is not available on this device. Type the barcode instead."
                   Style="{StaticResource CaptionLabel}"
                   IsVisible="{Binding IsCameraUnavailable}" />

            <Label Text="Barcode" Style="{StaticResource SectionLabel}" />
            <Entry Text="{Binding ManualBarcode, Mode=TwoWay}"
                   Placeholder="EAN-13 or UPC-A"
                   Keyboard="Numeric"
                   ReturnCommand="{Binding LookUpCommand}" AutomationId="ManualBarcodeEntry" />
            <Button StyleClass="Primary" Text="Find product" Command="{Binding LookUpCommand}" HorizontalOptions="Start" AutomationId="FindProductButton" />

            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" AutomationId="ScannerStatusLabel" />

            <HorizontalStackLayout Spacing="10">
                <Button StyleClass="Outlined" Text="Add this product" Command="{Binding CreateProductCommand}"
                        IsVisible="{Binding CanCreateProduct}" AutomationId="AddThisProductButton" />
                <Button StyleClass="Outlined" Text="Create from Open Food Facts" Command="{Binding CreateFromLookupCommand}" AutomationId="CreateFromLookupButton"
                        IsVisible="{Binding CanCreateProduct}" />
                <Button StyleClass="Outlined" Text="Scan again" Command="{Binding ScanAgainCommand}" AutomationId="ScanAgainButton"
                        IsVisible="{Binding CanScanAgain}" />
            </HorizontalStackLayout>

            <Label Text="{Binding LookupAttribution}" Style="{StaticResource CaptionLabel}"
                   IsVisible="{Binding CanCreateProduct}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
