<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.ScannerPage"
             x:DataType="viewModels:ScannerViewModel"
             Title="Scan barcode">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="Container, Container, Container, All">
        <components:AppBar Title="Scan barcode" BackCommand="{Binding GoBackCommand}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{OnIdiom Default='24,8', Phone='16,8'}" Spacing="8" MaximumWidthRequest="720">
                <Border HeightRequest="280" IsVisible="{Binding IsCameraSupported}" StrokeShape="RoundRectangle 10">
                    <views:CameraScannerView IsActive="{Binding IsCameraActive}"
                                             DetectedCommand="{Binding BarcodeDetectedCommand}" />
                </Border>
                <components:CameraStatusBanner Message="{Binding UnavailableText}" />

                <components:OutlinedField Label="Barcode" Placeholder="EAN-13 or UPC-A" Keyboard="Numeric"
                                          EntryId="ManualBarcodeEntry" Text="{Binding ManualBarcode, Mode=TwoWay}"
                                          ReturnCommand="{Binding LookUpCommand}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" AutomationId="ScannerStatusLabel" />

                <Button StyleClass="Outlined" Text="Add this product" Command="{Binding CreateProductCommand}"
                        IsVisible="{Binding CanCreateProduct}" AutomationId="AddThisProductButton" />
                <Button StyleClass="Outlined" Text="Create from Open Food Facts" Command="{Binding CreateFromLookupCommand}"
                        IsVisible="{Binding CanCreateProduct}" AutomationId="CreateFromLookupButton" />
                <Button StyleClass="Outlined" Text="Scan again" Command="{Binding ScanAgainCommand}"
                        IsVisible="{Binding CanScanAgain}" AutomationId="ScanAgainButton" />
                <Label Text="{Binding LookupAttribution}" Style="{StaticResource CaptionLabel}"
                       IsVisible="{Binding CanCreateProduct}" />
            </VerticalStackLayout>
        </ScrollView>
        <components:BottomActionBar Grid.Row="2" ButtonId="FindProductButton" Text="Find product"
                                    Command="{Binding LookUpCommand}" />
    </Grid>
</ContentPage>
