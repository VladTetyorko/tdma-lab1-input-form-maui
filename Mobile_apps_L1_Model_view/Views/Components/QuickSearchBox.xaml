<?xml version="1.0" encoding="utf-8"?>

<!-- The typing field with its drop-down. The list lies in the page flow under the field (not a popup), so it works the
     same on both platforms and the Android keyboard cannot cover it. Product name first, code last; no inner scrolling -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.Components.QuickSearchBox"
             x:DataType="viewModels:QuickSearchViewModel"
             x:Name="ThisBox">
    <VerticalStackLayout Spacing="4">
        <components:OutlinedField x:Name="Field" Icon="{StaticResource IconSearch}"
                                  ClearId="QuickSearchClearButton" Text="{Binding Query, Mode=TwoWay}"
                                  ReturnCommand="{Binding SubmitCommand}" />

        <!-- A warning of the host page, directly under the box and above the drop-down -->
        <Grid x:Name="NoticeRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
            <Label x:Name="NoticeLabel" Style="{StaticResource TextBody}" VerticalOptions="Center"
                   TextColor="{DynamicResource Warning}" AutomationId="DuplicateLabel" />
            <Button x:Name="NoticeButton" Grid.Column="1" Text="Open" StyleClass="Outlined" AutomationId="OpenDuplicateButton" />
        </Grid>

        <Border IsVisible="{Binding IsOpen}" StrokeShape="RoundRectangle 6" Background="{DynamicResource BackgroundBrush}"
                Stroke="{DynamicResource BorderStrongBrush}">
            <VerticalStackLayout>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" AutomationId="QuickSearchSuggestions">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:QuickSearchRow">
                            <Grid RowDefinitions="Auto,1">
                                <Grid MinimumHeightRequest="{OnIdiom 56, Desktop=44}">
                                    <BoxView Color="{DynamicResource PrimarySoft}" IsVisible="{Binding IsHighlighted}" />
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Padding="12,6" ColumnSpacing="8">
                                        <components:HighlightedLabel Value="{Binding Suggestion.Title}"
                                                                     Ranges="{Binding Suggestion.NameRanges}"
                                                                     Style="{StaticResource TextBodyStrong}">
                                            <components:HighlightedLabel.Triggers>
                                                <DataTrigger TargetType="components:HighlightedLabel" Binding="{Binding IsUnavailable}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                                </DataTrigger>
                                            </components:HighlightedLabel.Triggers>
                                        </components:HighlightedLabel>
                                        <Label Grid.Column="1" Text="{Binding Suggestion.StockText}" Style="{StaticResource TextCaption}"
                                               IsVisible="{Binding IsAvailable}" />
                                        <Border Grid.Column="1" StyleClass="ChipDanger" HorizontalOptions="End"
                                                IsVisible="{Binding IsUnavailable}">
                                            <Label Text="Out of stock" Style="{StaticResource ChipDangerText}" />
                                        </Border>
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Suggestion.Details}"
                                               Style="{StaticResource TextCaption}" />
                                        <components:HighlightedLabel Grid.Row="2" Value="{Binding Suggestion.Code}"
                                                                     Ranges="{Binding Suggestion.CodeRanges}"
                                                                     Style="{StaticResource TextCaption}" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="Similar name" HorizontalTextAlignment="End"
                                               Style="{StaticResource TextCaption}" IsVisible="{Binding Suggestion.IsFuzzy}"
                                               AutomationId="SuggestionSimilarLabel" />
                                    </Grid>
                                    <Button StyleClass="RowOverlay" CommandParameter="{Binding .}"
                                            Command="{Binding BindingContext.PickCommand, Source={x:Reference ThisBox}}"
                                            SemanticProperties.Description="{Binding Suggestion.Title}"
                                            AutomationId="{Binding AutomationId}" />
                                </Grid>
                                <BoxView Grid.Row="1" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasNoMatch}" Padding="12,8" Spacing="8">
                    <Label Text="{Binding NoMatchText}" Style="{StaticResource TextBody}" AutomationId="QuickSearchNoMatch" />
                    <Button Text="{Binding CreateText}" StyleClass="Outlined" HorizontalOptions="Start"
                            IsVisible="{Binding CanCreate}" Command="{Binding CreateCommand}"
                            AutomationId="QuickSearchCreateButton" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
