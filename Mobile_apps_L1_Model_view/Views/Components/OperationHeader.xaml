<?xml version="1.0" encoding="utf-8"?>

<!-- The header band of the operation table. Same columns as the rows of OperationTable -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile_apps_L1_Model_view.Views.Components.OperationHeader">
    <Grid ColumnDefinitions="48,*,Auto,56" ColumnSpacing="8" Padding="8,0" HeightRequest="36"
          BackgroundColor="{DynamicResource SurfaceAlt}">
        <Label Text="Qty" Style="{StaticResource TableHeader}" HorizontalTextAlignment="End" />
        <Label Grid.Column="1" Text="Product" Style="{StaticResource TableHeader}" />
        <Label x:Name="ByLabel" Grid.Column="2" Text="By" Style="{StaticResource TableHeader}" WidthRequest="32"
               HorizontalTextAlignment="Center" />
        <Label Grid.Column="3" Text="Time" Style="{StaticResource TableHeader}" HorizontalTextAlignment="End" />
    </Grid>
</ContentView>
