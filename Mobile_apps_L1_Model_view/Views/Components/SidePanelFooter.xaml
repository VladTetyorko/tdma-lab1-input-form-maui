<?xml version="1.0" encoding="utf-8"?>

<components:SessionView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
                        xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
                        xmlns:services="clr-namespace:Mobile_apps_L1_Model_view.Services;assembly=StockRoom.Core"
                        x:Class="Mobile_apps_L1_Model_view.Views.Components.SidePanelFooter"
                        x:DataType="viewModels:SessionStatusViewModel">
    <VerticalStackLayout Padding="16" Spacing="8">
        <components:SyncChip />
        <Button Text="Scan" StyleClass="Outlined" Command="{Binding ScanCommand}" AutomationId="PanelScanButton" />
        <Button Text="Sign out" StyleClass="Ghost" Command="{Binding SignOutCommand}" AutomationId="PanelSignOutButton" />
    </VerticalStackLayout>
</components:SessionView>
