<?xml version="1.0" encoding="utf-8"?>

<!-- The one way a product is shown (R3): name (bold, two lines, search highlight), code with an "Out of stock" chip,
     and a right column the page fills (stock, a stepper, a counted field, table cells) -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             x:Class="Mobile_apps_L1_Model_view.Views.Components.ProductRow">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8" MinimumHeightRequest="{OnIdiom 56, Desktop=44}">
        <VerticalStackLayout VerticalOptions="Center">
            <components:HighlightedLabel x:Name="NameLabel" Style="{StaticResource TextBodyStrong}" MaxLines="2"
                                         LineBreakMode="TailTruncation" AutomationId="ProductNameLabel" />
            <HorizontalStackLayout Spacing="8">
                <components:HighlightedLabel x:Name="CodeLabel" Style="{StaticResource TextCaption}" MaxLines="1"
                                             VerticalOptions="Center" />
                <Border x:Name="OutChip" StyleClass="ChipDanger" Padding="6,0" IsVisible="False">
                    <Label Text="Out of stock" Style="{StaticResource ChipDangerText}" />
                </Border>
            </HorizontalStackLayout>
            <Label x:Name="NoteLabel" Style="{StaticResource TextCaption}" IsVisible="False" />
            <HorizontalStackLayout x:Name="ProblemRow" Spacing="4" IsVisible="False">
                <Label Text="{StaticResource IconWarning}" Style="{StaticResource IconGlyph}" FontSize="16"
                       TextColor="{DynamicResource Danger}" />
                <Label x:Name="ProblemLabel" Style="{StaticResource ErrorLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <ContentView x:Name="RightHost" Grid.Column="1" VerticalOptions="Center" />
    </Grid>
</ContentView>
