<?xml version="1.0" encoding="utf-8"?>

<components:SessionView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
                        xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
                        xmlns:services="clr-namespace:Mobile_apps_L1_Model_view.Services;assembly=StockRoom.Core"
                        x:Class="Mobile_apps_L1_Model_view.Views.Components.StatusHeader"
                        x:DataType="viewModels:SessionStatusViewModel"
                        IsVisible="{OnIdiom Default=False, Phone=True}">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <VerticalStackLayout VerticalOptions="Center">
            <Label Text="{Binding UserName}" Style="{StaticResource TextBodyStrong}" LineBreakMode="TailTruncation" />
            <Label Text="{Binding RoleText}" Style="{StaticResource TextCaption}" />
        </VerticalStackLayout>
        <components:SyncChip Grid.Column="1" />
        <Button Grid.Column="2" Text="Scan" StyleClass="Outlined" Command="{Binding ScanCommand}"
                AutomationId="HeaderScanButton" />
    </Grid>
</components:SessionView>
