<?xml version="1.0" encoding="utf-8"?>

<!-- Why there is no camera picture and what to do about it. Hidden while the message is empty -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile_apps_L1_Model_view.Views.Components.CameraStatusBanner"
             IsVisible="False">
    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,8"
            Background="{DynamicResource WarningSoftBrush}" AutomationId="CameraBanner">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Label Text="{StaticResource IconWarning}" Style="{StaticResource IconGlyph}"
                   TextColor="{DynamicResource Warning}" />
            <Label x:Name="MessageText" Grid.Column="1" Style="{StaticResource TextBody}" VerticalOptions="Center" />
            <Button x:Name="ActionButton" Grid.Column="2" StyleClass="Outlined" IsVisible="False"
                    AutomationId="AllowCameraButton" />
        </Grid>
    </Border>
</ContentView>
