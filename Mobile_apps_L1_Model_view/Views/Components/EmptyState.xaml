<?xml version="1.0" encoding="utf-8"?>

<!-- Nothing to show: icon, title, what to do next and optionally a button that does it -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile_apps_L1_Model_view.Views.Components.EmptyState">
    <VerticalStackLayout Spacing="8" Padding="16,32" HorizontalOptions="Center">
        <Label x:Name="GlyphLabel" Style="{StaticResource IconGlyph}" FontSize="40" HorizontalOptions="Center"
               TextColor="{DynamicResource TextDisabled}" />
        <Label x:Name="TitleLabel" Style="{StaticResource TextHeading}" HorizontalTextAlignment="Center" />
        <Label x:Name="MessageText" Style="{StaticResource TextCaption}" HorizontalTextAlignment="Center" />
        <Button x:Name="ActionButton" StyleClass="Outlined" HorizontalOptions="Center" IsVisible="False" />
    </VerticalStackLayout>
</ContentView>
