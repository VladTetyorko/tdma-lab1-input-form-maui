<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.Components.RecentActivityPanel">
    <Border x:Name="Card" StyleClass="SectionCard" x:DataType="viewModels:RecentActivityViewModel"
            IsVisible="{Binding HasItems}" AutomationId="RecentActivity">
        <VerticalStackLayout Spacing="4">
            <Label Text="Recent activity" Style="{StaticResource TextOverline}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:RecentActivityItem">
                        <components:ActivityRow />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
