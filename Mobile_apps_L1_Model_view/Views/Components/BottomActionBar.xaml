<?xml version="1.0" encoding="utf-8"?>

<!-- The one main action of a page: a big filled button at the bottom, full width on a phone, never smaller than an input.
     The page puts it in the last row of a grid with SafeAreaEdges "...SoftInput", so it stays above the keyboard -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile_apps_L1_Model_view.Views.Components.BottomActionBar">
    <Grid RowDefinitions="1,Auto" BackgroundColor="{DynamicResource Surface}">
        <BoxView />
        <VerticalStackLayout Grid.Row="1" Padding="16,12" Spacing="4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalOptions="{OnIdiom Fill, Desktop=End}">
                <!-- Desktop only: Cancel next to the main action -->
                <Button x:Name="SecondaryButton" StyleClass="Outlined" IsVisible="False"
                        HeightRequest="{OnIdiom 56, Desktop=48}" />
                <Button x:Name="ActionButton" Grid.Column="1" StyleClass="Primary" FontSize="17"
                        HeightRequest="{OnIdiom 56, Desktop=48}" MinimumWidthRequest="320" />
            </Grid>
            <Label x:Name="CaptionText" Style="{StaticResource TextCaption}" IsVisible="False"
                   HorizontalTextAlignment="{OnIdiom Center, Desktop=End}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
