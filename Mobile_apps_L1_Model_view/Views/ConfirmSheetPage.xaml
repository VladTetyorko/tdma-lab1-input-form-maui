<?xml version="1.0" encoding="utf-8"?>

<!-- Dimmed page below, a card at the bottom: the question, what will happen, and the action where the page's main
     button was -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile_apps_L1_Model_view.Views.ConfirmSheetPage">
    <Grid RowDefinitions="*,Auto" SafeAreaEdges="Container">
        <BoxView BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancel" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" StrokeShape="RoundRectangle 16,16,0,0"
                Padding="16" MaximumWidthRequest="640" AutomationId="ConfirmSheet">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="TitleText" Style="{StaticResource TextTitle}" SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="MessageText" Style="{StaticResource TextBody}" AutomationId="ConfirmMessage" />
                <ScrollView MaximumHeightRequest="240">
                    <VerticalStackLayout x:Name="LineList" Spacing="4" />
                </ScrollView>
                <Button x:Name="AcceptButton" FontSize="17" HeightRequest="56" Margin="0,8,0,0" Clicked="OnAccept"
                        AutomationId="ConfirmAcceptButton" />
                <Button x:Name="CancelButton" StyleClass="Outlined" HeightRequest="48" Clicked="OnCancel"
                        AutomationId="ConfirmCancelButton" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
