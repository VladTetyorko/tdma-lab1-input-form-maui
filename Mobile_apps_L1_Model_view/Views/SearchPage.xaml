<?xml version="1.0" encoding="utf-8"?>

<!-- Find one product (design revision 4, 5.5): camera first, then the field, then at most five product rows -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.SearchPage"
             x:DataType="viewModels:SearchViewModel"
             x:Name="ThisPage"
             Title="Search">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*" SafeAreaEdges="Container">
        <components:AppBar Grid.Column="1" Title="Search" Route="search" />
        <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout Padding="{OnIdiom Default='24,8', Phone='16,8'}" Spacing="8" MaximumWidthRequest="720">
                <Border HeightRequest="220" IsVisible="{Binding IsCameraActive}" StrokeShape="RoundRectangle 10">
                    <views:CameraScannerView IsActive="{Binding IsCameraActive}" DetectedCommand="{Binding ScanDetectedCommand}" />
                </Border>
                <components:CameraStatusBanner Message="{Binding CameraMessage}" ActionText="{Binding CameraActionText}"
                                               ActionCommand="{Binding RetryCameraCommand}" />
                <components:OutlinedField x:Name="Field" Icon="{StaticResource IconSearch}" Placeholder="Name or barcode"
                                          EntryId="SearchFieldEntry" ClearId="SearchFieldClearButton"
                                          Text="{Binding QuickSearch.Query, Mode=TwoWay}"
                                          ReturnCommand="{Binding QuickSearch.SubmitCommand}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding QuickSearch.Suggestions}" AutomationId="SearchResults">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:QuickSearchRow">
                            <Grid RowDefinitions="Auto,1">
                                <components:ProductRow ProductName="{Binding Suggestion.Title}"
                                                       NameRanges="{Binding Suggestion.NameRanges}"
                                                       Code="{Binding Suggestion.Code}" CodeRanges="{Binding Suggestion.CodeRanges}"
                                                       IsOutOfStock="{Binding Suggestion.IsOutOfStock}"
                                                       Note="{Binding Suggestion.SimilarText}">
                                    <components:ProductRow.Right>
                                        <Label Text="{Binding Suggestion.Product.Quantity}" Style="{StaticResource TextNumeric}" />
                                    </components:ProductRow.Right>
                                </components:ProductRow>
                                <Button StyleClass="RowOverlay" CommandParameter="{Binding .}"
                                        Command="{Binding BindingContext.QuickSearch.PickCommand, Source={x:Reference ThisPage}, x:DataType=ContentPage}"
                                        SemanticProperties.Description="{Binding Suggestion.Title}"
                                        AutomationId="{Binding AutomationId}" />
                                <BoxView Grid.Row="1" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding QuickSearch.HasNoMatch}" Spacing="8">
                    <Label Text="{Binding QuickSearch.NoMatchText}" Style="{StaticResource TextBody}" AutomationId="SearchNoMatch" />
                    <Button Text="Create product" StyleClass="Outlined" IsVisible="{Binding QuickSearch.CanCreate}"
                            Command="{Binding QuickSearch.CreateCommand}" AutomationId="QuickSearchCreateButton" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsUnknown}" Spacing="8">
                    <Label Text="{Binding UnknownText}" Style="{StaticResource TextBodyStrong}" AutomationId="SearchUnknown" />
                    <Label Text="{Binding LookupText}" Style="{StaticResource TextCaption}" />
                    <Button Text="Create product" StyleClass="Primary" HeightRequest="56" IsVisible="{Binding CanCreateUnknown}"
                            Command="{Binding CreateCommand}" AutomationId="SearchCreateButton" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <components:BottomNav Grid.Row="2" Grid.Column="1" />
    </Grid>
</ContentPage>
