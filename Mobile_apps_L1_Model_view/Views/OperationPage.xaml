<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels"
             x:Class="Mobile_apps_L1_Model_view.Views.OperationPage"
             x:DataType="viewModels:OperationViewModel"
             Title="Record operation">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
        <views:FocusOnAppearingBehavior Target="{x:Reference QuantityEntry}" />
    </ContentPage.Behaviors>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="8">
            <Label Text="{Binding ProductName}" Style="{StaticResource Headline}" />
            <Label Text="{Binding QuantityOnHand, StringFormat='On hand: {0} pcs'}"
                   Style="{StaticResource CaptionLabel}" />

            <Label Text="Direction" />
            <Picker ItemsSource="{Binding AvailableDirections}"
                    SelectedItem="{Binding SelectedDirection, Mode=TwoWay}" AutomationId="DirectionPicker" />

            <Label Text="Units" />
            <Entry x:Name="QuantityEntry" Text="{Binding Quantity, Mode=TwoWay}" Keyboard="Numeric" AutomationId="QuantityEntry"
                   ReturnCommand="{Binding SaveCommand}" />
            <Stepper Minimum="1" Maximum="10000" Increment="1" Value="{Binding Quantity, Mode=TwoWay}" />

            <Label Text="Counterparty (optional)" />
            <Entry Text="{Binding Counterparty, Mode=TwoWay}" Placeholder="Supplier or customer" AutomationId="CounterpartyEntry" />

            <Label Text="Reason (optional)" />
            <Entry Text="{Binding Reason, Mode=TwoWay}" Placeholder="Why" AutomationId="ReasonEntry" />

            <Label Text="Location (optional)" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Attach my location" Command="{Binding AttachLocationCommand}"
                        AutomationId="AttachLocationButton" />
                <Button Text="Clear location" Command="{Binding ClearLocationCommand}"
                        IsVisible="{Binding HasLocation}" AutomationId="ClearLocationButton" />
                <ActivityIndicator IsRunning="{Binding IsLocating}" IsVisible="{Binding IsLocating}" />
            </HorizontalStackLayout>
            <Label Text="{Binding LocationText}" Style="{StaticResource CaptionLabel}" AutomationId="LocationLabel" />
            <Label Text="{Binding LocationMessage}" Style="{StaticResource ErrorLabel}" />

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" AutomationId="ErrorLabel" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Save" Command="{Binding SaveCommand}" AutomationId="SaveOperationButton" />
                <Button Text="Cancel" Command="{Binding GoBackCommand}" AutomationId="CancelOperationButton" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
