<?xml version="1.0" encoding="utf-8"?>

<!-- One operation with a reason or a location (the product's ⋮ menu): product, In or Out, units, the optional facts and
     one action named after its result. Back (the arrow) cancels -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.OperationPage"
             x:DataType="viewModels:OperationViewModel"
             Title="Record operation">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="Container, Container, Container, All">
        <components:AppBar Title="Record operation" BackCommand="{Binding GoBackCommand}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{OnIdiom Default='24,8', Phone='16,8'}" Spacing="12" MaximumWidthRequest="720">
                <components:ProductRow ProductName="{Binding ProductName}" Code="{Binding Barcode}" Margin="-12,0">
                    <components:ProductRow.Right>
                        <Label Text="{Binding QuantityOnHand}" Style="{StaticResource TextNumeric}" />
                    </components:ProductRow.Right>
                </components:ProductRow>

                <HorizontalStackLayout Spacing="8">
                    <Button Text="In" StyleClass="Choice" MinimumWidthRequest="96" Command="{Binding SelectInCommand}"
                            AutomationId="DirectionIn">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsIn}" Value="True">
                                <Setter Property="Text" Value="✓ In" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoft}" />
                                <Setter Property="BorderWidth" Value="2" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Out" StyleClass="Choice" MinimumWidthRequest="96" Command="{Binding SelectOutCommand}"
                            IsVisible="{Binding CanOut}" AutomationId="DirectionOut">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsOut}" Value="True">
                                <Setter Property="Text" Value="✓ Out" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoft}" />
                                <Setter Property="BorderWidth" Value="2" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <components:OutlinedField x:Name="QuantityField" Label="Units" Keyboard="Numeric" MaxLength="5" ShowClear="False"
                                          EntryId="QuantityEntry" Text="{Binding Quantity, Mode=TwoWay}"
                                          ReturnCommand="{Binding SaveCommand}" />
                <components:OutlinedField Label="Supplier or recipient (optional)" EntryId="CounterpartyEntry"
                                          Text="{Binding Counterparty, Mode=TwoWay}" />
                <components:OutlinedField Label="Reason (optional)" EntryId="ReasonEntry" Text="{Binding Reason, Mode=TwoWay}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding LocationText}" Style="{StaticResource TextCaption}" VerticalOptions="Center"
                           AutomationId="LocationLabel" />
                    <Grid Grid.Column="1">
                        <Button StyleClass="Outlined" Text="Attach my location" Command="{Binding AttachLocationCommand}"
                                AutomationId="AttachLocationButton" />
                        <Button StyleClass="Outlined" Text="Clear location" Command="{Binding ClearLocationCommand}"
                                IsVisible="{Binding HasLocation}" AutomationId="ClearLocationButton"
                                BackgroundColor="{DynamicResource Background}" />
                    </Grid>
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsLocating}" IsVisible="{Binding IsLocating}" />
                <Label Text="{Binding LocationMessage}" Style="{StaticResource ErrorLabel}" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" AutomationId="ErrorLabel" />
            </VerticalStackLayout>
        </ScrollView>
        <components:BottomActionBar Grid.Row="2" ButtonId="SaveOperationButton" Text="{Binding SaveText}"
                                    Command="{Binding SaveCommand}" />
    </Grid>
</ContentPage>
