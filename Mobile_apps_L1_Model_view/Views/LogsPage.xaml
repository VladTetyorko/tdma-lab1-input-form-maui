<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:services="clr-namespace:Mobile_apps_L1_Model_view.Services;assembly=StockRoom.Core"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.LogsPage"
             x:DataType="viewModels:LogsViewModel"
             Title="Logs">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,10" RowSpacing="8">
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Level" VerticalOptions="Center" />
            <Picker ItemsSource="{Binding Levels}"
                    SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                    WidthRequest="160"
                    AutomationId="LogLevelPicker" />
            <Button StyleClass="Outlined" Text="Refresh" Command="{Binding RefreshCommand}" AutomationId="LogRefreshButton" />
        </HorizontalStackLayout>

        <Label Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource CaptionLabel}"
               AutomationId="LogEmptyLabel" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Entries}" AutomationId="LogEntriesList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:LogEntry">
                    <VerticalStackLayout Padding="0,6" Spacing="2">
                        <Label FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Timestamp, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}" />
                                    <Span Text="  " />
                                    <Span Text="{Binding LevelCode}" />
                                    <Span Text="  " />
                                    <Span Text="{Binding ShortSource}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding Message}" />
                        <Label Text="{Binding Exception}" IsVisible="{Binding HasException}"
                               Style="{StaticResource ErrorLabel}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
