<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.ProductFormPage"
             x:DataType="viewModels:ProductFormViewModel"
             Title="{Binding PageTitle}">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="8">
            <Label Text="Name" />
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Product name" AutomationId="ProductNameEntry" />
            <Label Text="{Binding NameError}" Style="{StaticResource ErrorLabel}" AutomationId="NameErrorLabel" />

            <Label Text="Barcode (EAN-13)" />
            <Entry Text="{Binding Barcode, Mode=TwoWay}" Placeholder="13 digits" Keyboard="Numeric" MaxLength="13" AutomationId="BarcodeEntry" />
            <Label Text="{Binding BarcodeError}" Style="{StaticResource ErrorLabel}" AutomationId="BarcodeErrorLabel" />

            <Label Text="Photo" />
            <Image Source="{Binding Photo.ResolvedPath}" IsVisible="{Binding Photo.HasPhoto}"
                   Style="{StaticResource Thumbnail}" AutomationId="ProductPhoto" />
            <FlexLayout Wrap="Wrap" IsVisible="{Binding CanManagePhotos}">
                <Button StyleClass="Outlined" Text="Take photo" Command="{Binding TakePhotoCommand}" AutomationId="TakePhotoButton"
                        IsVisible="{Binding Photo.IsCaptureSupported}" Margin="0,0,10,6" />
                <Button StyleClass="Outlined" Text="Pick photo" Command="{Binding PickPhotoCommand}" AutomationId="PickPhotoButton"
                        Margin="0,0,10,6" />
                <Button StyleClass="Danger" Text="Remove photo" Command="{Binding RemovePhotoCommand}" AutomationId="RemovePhotoButton"
                        IsVisible="{Binding Photo.HasPhoto}" Margin="0,0,10,6" />
            </FlexLayout>

            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" AutomationId="StatusLabel" />

            <Label Text="{Binding DataSource}" Style="{StaticResource CaptionLabel}" />

            <HorizontalStackLayout Spacing="10">
                <Button StyleClass="Primary" Text="Save" Command="{Binding SaveCommand}" AutomationId="SaveProductButton" />
                <Button StyleClass="Ghost" Text="Cancel" Command="{Binding CancelCommand}" AutomationId="CancelProductButton" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
