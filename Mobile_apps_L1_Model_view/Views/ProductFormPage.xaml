<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels"
             x:Class="Mobile_apps_L1_Model_view.Views.ProductFormPage"
             x:DataType="viewModels:ProductFormViewModel"
             Title="{Binding PageTitle}">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="8">
            <Label Text="Name" />
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Product name" />
            <Label Text="{Binding NameError}" Style="{StaticResource ErrorLabel}" />

            <Label Text="Barcode (EAN-13)" />
            <Entry Text="{Binding Barcode, Mode=TwoWay}" Placeholder="13 digits" Keyboard="Numeric" MaxLength="13" />
            <Label Text="{Binding BarcodeError}" Style="{StaticResource ErrorLabel}" />

            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Save" Command="{Binding SaveCommand}" />
                <Button Text="Cancel" Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
