<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:services="clr-namespace:Mobile_apps_L1_Model_view.Services;assembly=StockRoom.Core"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.ProductDetailPage"
             x:DataType="viewModels:ProductDetailViewModel"
             Title="Product">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">
        <components:AppBar Title="Product" BackCommand="{Binding GoBackCommand}" />
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="{OnIdiom Default='24,8', Phone='16,8'}" Spacing="8" MaximumWidthRequest="720">
            <Label Text="{Binding Name}" Style="{StaticResource TextTitle}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Barcode, StringFormat='Barcode {0}'}" Style="{StaticResource CaptionLabel}" />
            <Label Text="{Binding Quantity, StringFormat='On hand: {0} pcs'}" Style="{StaticResource TextDisplay}" />

            <Image Source="{Binding Photo.ResolvedPath}" IsVisible="{Binding Photo.HasPhoto}"
                   Style="{StaticResource Thumbnail}" AutomationId="ProductPhoto" />
            <FlexLayout Wrap="Wrap" IsVisible="{Binding CanEdit}">
                <Button Text="Take photo" Command="{Binding TakePhotoCommand}" AutomationId="TakePhotoButton"
                        IsVisible="{Binding Photo.IsCaptureSupported}" StyleClass="Compact,Outlined" Margin="0,0,10,6" />
                <Button Text="Pick photo" Command="{Binding PickPhotoCommand}" AutomationId="PickPhotoButton"
                        StyleClass="Compact,Outlined" Margin="0,0,10,6" />
                <Button Text="Remove photo" Command="{Binding RemovePhotoCommand}" AutomationId="RemovePhotoButton"
                        IsVisible="{Binding Photo.HasPhoto}" StyleClass="Compact,Danger" Margin="0,0,10,6" />
            </FlexLayout>

            <Border StyleClass="SectionCard">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Characteristics" Style="{StaticResource SectionLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Characteristics}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CharacteristicEditItem">
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding Value, Mode=TwoWay}"
                                           Placeholder="{Binding Placeholder}"
                                           IsReadOnly="{Binding IsReadOnly}" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Error}"
                                           Style="{StaticResource ErrorLabel}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>
            </Border>

            <FlexLayout Wrap="Wrap">
                <Button StyleClass="Outlined" Text="Save" Command="{Binding SaveCommand}" AutomationId="SaveCharacteristicsButton" IsVisible="{Binding CanEdit}" />
                <Button StyleClass="Primary" Text="Record In/Out" Command="{Binding OpenOperationCommand}" AutomationId="RecordOperationButton" />
                <Button StyleClass="Outlined" Text="Receive" Command="{Binding StartReceiveCommand}" AutomationId="DetailReceiveButton" />
                <Button StyleClass="Outlined" Text="Issue" Command="{Binding StartIssueCommand}" IsVisible="{Binding CanIssue}"
                        AutomationId="DetailIssueButton" />
            </FlexLayout>

            <Border StyleClass="SectionCard">
                <VerticalStackLayout Spacing="8">
                    <Label Text="History" Style="{StaticResource SectionLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:OperationHistoryItem">
                                <VerticalStackLayout>
                                    <Label FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Direction}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Quantity}" />
                                                <Span Text=" pcs" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding At, StringFormat='{0:yyyy-MM-dd HH:mm} UTC'}"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Label Text="{Binding UserName, StringFormat='By {0}'}"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Label Text="{Binding Details}" Style="{StaticResource CaptionLabel}" />
                                    <!-- Only for an operation recorded with a location -->
                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasLocation}">
                                        <Label Text="{Binding LocationText}" Style="{StaticResource CaptionLabel}"
                                               VerticalOptions="Center" AutomationId="HistoryLocationLabel" />
                                        <Button Text="Open in maps" StyleClass="Compact,Outlined" AutomationId="OpenInMapsButton"
                                                Command="{Binding OpenLocationCommand, Source={RelativeSource AncestorType={x:Type viewModels:ProductDetailViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
