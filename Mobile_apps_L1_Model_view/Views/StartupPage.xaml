<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels"
             x:Class="Mobile_apps_L1_Model_view.Views.StartupPage"
             x:DataType="viewModels:StartupStatus"
             Title="StockRoom">

    <VerticalStackLayout Padding="30" Spacing="12" VerticalOptions="Center">
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Text="{Binding Message}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
