<?xml version="1.0" encoding="utf-8"?>

<!-- What needs me today (design revision 4, 5.2): drafts to continue, what has run out, today's operations. No tiles:
     receiving and issuing are the pill of the bottom bar. No numbers to interpret, only lists to act on -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:services="clr-namespace:Mobile_apps_L1_Model_view.Services;assembly=StockRoom.Core"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.HomePage"
             x:DataType="viewModels:HomeViewModel"
             x:Name="ThisPage"
             Title="StockRoom">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*" SafeAreaEdges="Container">
        <components:AppBar Grid.Column="1" Title="StockRoom" Route="home" />
        <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout Padding="{OnIdiom Default='24,8', Phone='16,8'}" Spacing="12" MaximumWidthRequest="720">
                <VerticalStackLayout>
                    <components:SyncChip OnlyWhenNeeded="True" HorizontalOptions="End" />
                    <Label Text="{Binding Greeting}" Style="{StaticResource TextTitle}" SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>
                <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <VerticalStackLayout IsVisible="{Binding HasDrafts}" Spacing="8">
                    <Label Text="Continue" Style="{StaticResource TextOverline}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Drafts}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DraftRow">
                                <Border StyleClass="SectionCard" Padding="12,0">
                                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                                        <Label Text="{Binding Text}" Style="{StaticResource TextBodyStrong}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{StaticResource IconChevronRight}" Style="{StaticResource IconGlyph}" />
                                        <Button Grid.ColumnSpan="2" StyleClass="RowOverlay" CommandParameter="{Binding .}"
                                                Command="{Binding BindingContext.ContinueCommand, Source={x:Reference ThisPage}, x:DataType=ContentPage}"
                                                SemanticProperties.Description="{Binding Text}" AutomationId="HomeDraftRow" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasOutOfStock}">
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="40">
                        <Label Text="{Binding OutOfStockTitle}" Style="{StaticResource TextOverline}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{StaticResource IconChevronRight}" Style="{StaticResource IconGlyph}" />
                        <Button Grid.ColumnSpan="2" StyleClass="RowOverlay" Command="{Binding OpenOutOfStockCommand}"
                                SemanticProperties.Description="{Binding OutOfStockTitle}" AutomationId="HomeOutOfStock" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OutOfStock}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:ProductSummary">
                                <Grid RowDefinitions="Auto,1">
                                    <components:ProductRow ProductName="{Binding Name}" Code="{Binding Barcode}" IsOutOfStock="True">
                                        <components:ProductRow.Right>
                                            <Label Text="{Binding Quantity}" Style="{StaticResource TextNumeric}" />
                                        </components:ProductRow.Right>
                                    </components:ProductRow>
                                    <Button StyleClass="RowOverlay" CommandParameter="{Binding .}"
                                            Command="{Binding BindingContext.OpenProductCommand, Source={x:Reference ThisPage}, x:DataType=ContentPage}"
                                            SemanticProperties.Description="{Binding Name}" AutomationId="HomeProductRow" />
                                    <BoxView Grid.Row="1" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="40">
                        <Label Text="{Binding TodayTitle}" Style="{StaticResource TextOverline}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{StaticResource IconChevronRight}" Style="{StaticResource IconGlyph}" />
                        <Button Grid.ColumnSpan="2" StyleClass="RowOverlay" Command="{Binding OpenActivityCommand}"
                                SemanticProperties.Description="{Binding TodayTitle}" AutomationId="HomeToday" />
                    </Grid>
                    <VerticalStackLayout IsVisible="{Binding HasToday}">
                        <components:WideTable MinimumTableWidth="{StaticResource OperationTableMinWidth}">
                            <VerticalStackLayout>
                                <components:OperationHeader ShowBy="{Binding ShowBy}" />
                                <components:OperationTable ItemsSource="{Binding Today}" Command="{Binding OpenOperationCommand}"
                                                           AutomationId="HomeTodayTable" />
                            </VerticalStackLayout>
                        </components:WideTable>
                    </VerticalStackLayout>
                    <Label Text="{Binding TodayEmptyText}" Style="{StaticResource TextBody}" Padding="0,8"
                           TextColor="{DynamicResource TextSecondary}" AutomationId="HomeTodayEmpty" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <components:BottomNav Grid.Row="2" Grid.Column="1" />
    </Grid>
</ContentPage>
