<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.HomePage"
             x:DataType="viewModels:HomeViewModel"
             Title="StockRoom">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto">
        <components:AppBar Title="StockRoom" Route="home" />
        <ScrollView x:Name="Scroller" Grid.Row="1" SizeChanged="OnScrollerSizeChanged">
        <!-- The actions sit in the middle of the free height, within reach of a thumb (the code-behind gives the
             grid the height of the view) -->
        <Grid x:Name="Body" Padding="{OnIdiom Default='24,8', Phone='16,8'}" RowDefinitions="Auto,*,Auto,*,Auto"
              RowSpacing="8" MaximumWidthRequest="1200">
            <VerticalStackLayout>
                <components:SyncChip OnlyWhenNeeded="True" HorizontalOptions="End" />
                <Label Text="{Binding Greeting}" Style="{StaticResource TextTitle}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding RoleText}" Style="{StaticResource TextCaption}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="8">

            <!-- One column on a phone, two side by side on a wide window (code-behind) -->
            <Grid x:Name="Tiles" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <components:ActionTile x:Name="ReceiveTile" ButtonId="HomeReceiveTile" Title="Receive goods"
                                       Glyph="{StaticResource IconReceive}" Caption="{Binding ReceiveCaption}"
                                       Command="{Binding OpenReceiveCommand}" IsVisible="{Binding CanReceive}" />
                <components:ActionTile x:Name="IssueTile" Grid.Row="1" ButtonId="HomeIssueTile" Title="Issue goods"
                                       Glyph="{StaticResource IconIssue}" Caption="{Binding IssueCaption}"
                                       Command="{Binding OpenIssueCommand}" IsVisible="{Binding CanIssue}" />
            </Grid>
            <Label Text="{Binding IssueNote}" Style="{StaticResource TextCaption}" IsVisible="{Binding HasIssueNote}"
                   AutomationId="HomeIssueNotAllowedLabel" />

            <!-- Two buttons of equal width; alone, the first one takes the whole row -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Find a product" StyleClass="Outlined" Command="{Binding FindProductCommand}"
                        Grid.ColumnSpan="2" AutomationId="HomeFindProductButton">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding CanAddProduct}" Value="True">
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Add product" StyleClass="Outlined" Command="{Binding AddProductCommand}"
                        IsVisible="{Binding CanAddProduct}" AutomationId="HomeAddProductButton" />
            </Grid>
            </VerticalStackLayout>

            <components:RecentActivityPanel x:Name="Recent" Grid.Row="4" />
        </Grid>
    </ScrollView>
        <components:BottomNav Grid.Row="2" />
    </Grid>
</ContentPage>
