<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="StockRoom">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <VerticalStackLayout Padding="30,20" Spacing="16">
        <Label Text="Sign in" Style="{StaticResource Headline}" />
        <Label Text="Enter the login and password you were given." Style="{StaticResource CaptionLabel}" />

        <Entry Text="{Binding Login, Mode=TwoWay}"
               Placeholder="Login"
               Keyboard="Plain"
               AutomationId="LoginEntry" />
        <Entry Text="{Binding Password, Mode=TwoWay}"
               Placeholder="Password"
               IsPassword="True"
               ReturnCommand="{Binding SignInCommand}"
               AutomationId="PasswordEntry" />

        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Style="{StaticResource ErrorLabel}"
               AutomationId="ErrorLabel" />

        <Button StyleClass="Primary" Text="Sign in" Command="{Binding SignInCommand}" AutomationId="LoginButton" />
        <Button StyleClass="Outlined" Text="Unlock with biometrics"
                Command="{Binding BiometricSignInCommand}"
                IsVisible="{Binding IsBiometricAvailable}"
                AutomationId="BiometricButton" />
    </VerticalStackLayout>
</ContentPage>
