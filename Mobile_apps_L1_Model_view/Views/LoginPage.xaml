<?xml version="1.0" encoding="utf-8"?>

<!-- No app bar: the name is on the card. The card sits in the upper third, so Sign in stays above the keyboard -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Shell.FlyoutBehavior="Disabled"
             Title="StockRoom">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid SafeAreaEdges="Container">
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Default='24,64', Phone='16,48'}">
                <Border StyleClass="SectionCard" MaximumWidthRequest="400">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="StockRoom" Style="{StaticResource Headline}" />
                        <Label Text="Warehouse. Sign in with the login and password you were given."
                               Style="{StaticResource TextCaption}" HorizontalTextAlignment="Center" />
                        <components:OutlinedField Label="Login" EntryId="LoginEntry" Keyboard="Plain" ShowClear="False"
                                                  Text="{Binding Login, Mode=TwoWay}" />
                        <components:OutlinedField Label="Password" EntryId="PasswordEntry" IsPassword="True"
                                                  Text="{Binding Password, Mode=TwoWay}"
                                                  ReturnCommand="{Binding SignInCommand}" />
                        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                               Style="{StaticResource ErrorLabel}" AutomationId="ErrorLabel" />
                        <Button StyleClass="Primary" Text="Sign in" FontSize="17" HeightRequest="56"
                                Command="{Binding SignInCommand}" AutomationId="LoginButton" />
                        <Button StyleClass="Outlined" Text="Unlock with biometrics" Command="{Binding BiometricSignInCommand}"
                                IsVisible="{Binding IsBiometricAvailable}" AutomationId="BiometricButton" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
