<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:converters="clr-namespace:Mobile_apps_L1_Model_view.Converters"
             xmlns:services="clr-namespace:Mobile_apps_L1_Model_view.Services"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels"
             x:Class="Mobile_apps_L1_Model_view.Views.ProductsPage"
             x:DataType="viewModels:ProductListViewModel"
             Title="Products">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <converters:QuantityToColorConverter x:Key="QuantityToColorConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="20,10" RowSpacing="10">
        <Label Grid.Row="0" Text="{Binding CurrentUserName}" Style="{StaticResource CaptionLabel}" />

        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <Label Text="Sort by" VerticalOptions="Center" />
            <Picker ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                    WidthRequest="180" />
            <Label Text="Descending" VerticalOptions="Center" />
            <Switch IsToggled="{Binding SortDescending, Mode=TwoWay}" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Products}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:ProductSummary">
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,8" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <!-- Navigation starts in the ViewModel: the row is the command parameter -->
                            <TapGestureRecognizer
                                Command="{Binding OpenDetailsCommand, Source={RelativeSource AncestorType={x:Type viewModels:ProductListViewModel}}}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Barcode}" Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Quantity, StringFormat='{0} pcs'}"
                               Style="{StaticResource QuantityLabel}"
                               TextColor="{Binding Quantity, Converter={StaticResource QuantityToColorConverter}}" />
                        <!-- Manager only. A product that has operations cannot be deleted (see the note below the list) -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="6"
                                               IsVisible="{Binding CanManageProducts, Source={RelativeSource AncestorType={x:Type viewModels:ProductListViewModel}}}">
                            <Button Text="Edit" StyleClass="Compact"
                                    Command="{Binding EditProductCommand, Source={RelativeSource AncestorType={x:Type viewModels:ProductListViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Delete" StyleClass="Compact"
                                    IsEnabled="{Binding CanDelete}"
                                    Command="{Binding DeleteProductCommand, Source={RelativeSource AncestorType={x:Type viewModels:ProductListViewModel}}}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="4">
            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" />
            <Label Text="A product with stock history cannot be deleted: operations are permanent records."
                   Style="{StaticResource CaptionLabel}" IsVisible="{Binding CanManageProducts}" />
        </VerticalStackLayout>

        <FlexLayout Grid.Row="4" Wrap="Wrap">
            <Button Text="Add product" Command="{Binding AddProductCommand}"
                    IsVisible="{Binding CanAddProduct}" Margin="0,0,10,6" />
            <Button Text="Characteristics" Command="{Binding OpenCharacteristicsCommand}"
                    IsVisible="{Binding CanManageCharacteristics}" Margin="0,0,10,6" />
            <Button Text="Scan" Command="{Binding ScanCommand}" Margin="0,0,10,6" />
            <Button Text="Settings" Command="{Binding OpenSettingsCommand}" Margin="0,0,10,6" />
            <Button Text="Sign out" Command="{Binding SignOutCommand}" Margin="0,0,10,6" />
        </FlexLayout>
    </Grid>
</ContentPage>
