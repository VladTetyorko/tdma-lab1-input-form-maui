<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:converters="clr-namespace:Mobile_apps_L1_Model_view.Converters"
             xmlns:services="clr-namespace:Mobile_apps_L1_Model_view.Services;assembly=StockRoom.Core"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.ProductsPage"
             x:DataType="viewModels:ProductListViewModel"
             Title="Products">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <converters:QuantityToColorConverter x:Key="QuantityToColorConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Padding="20,10" RowSpacing="10">
        <components:StatusHeader Grid.Row="0" />

        <!-- Filters by name, barcode and characteristic values; combined with the sort below -->
        <SearchBar Grid.Row="1" Placeholder="Search by name, barcode or value"
                   Text="{Binding SearchText, Mode=TwoWay}" AutomationId="SearchEntry" />

        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Label Text="Sort by" VerticalOptions="Center" />
            <Picker ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                    WidthRequest="180" AutomationId="SortPicker" />
            <Label Text="Descending" VerticalOptions="Center" />
            <Switch IsToggled="{Binding SortDescending, Mode=TwoWay}" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Products}" AutomationId="ProductsCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:ProductSummary">
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,8" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <!-- Navigation starts in the ViewModel: the row is the command parameter -->
                            <TapGestureRecognizer
                                Command="{Binding OpenDetailsCommand, Source={RelativeSource AncestorType={x:Type viewModels:ProductListViewModel}}}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Name}" FontAttributes="Bold" AutomationId="ProductNameLabel" />
                            <Label Text="{Binding Barcode}" Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Quantity, StringFormat='{0} pcs'}"
                               Style="{StaticResource QuantityLabel}"
                               TextColor="{Binding Quantity, Converter={StaticResource QuantityToColorConverter}}" />
                        <!-- Manager only. A product that has operations cannot be deleted (see the note below the list) -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="6"
                                               IsVisible="{Binding CanManageProducts, Source={RelativeSource AncestorType={x:Type viewModels:ProductListViewModel}}}">
                            <Button Text="Edit" StyleClass="Compact,Outlined" AutomationId="EditProductButton"
                                    Command="{Binding EditProductCommand, Source={RelativeSource AncestorType={x:Type viewModels:ProductListViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Delete" StyleClass="Compact,Danger" AutomationId="DeleteProductButton"
                                    IsEnabled="{Binding CanDelete}"
                                    Command="{Binding DeleteProductCommand, Source={RelativeSource AncestorType={x:Type viewModels:ProductListViewModel}}}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Spacing="4">
            <Label Text="{Binding EmptyText}" Style="{StaticResource CaptionLabel}" AutomationId="EmptyLabel" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" AutomationId="StatusLabel" />
            <Label Text="A product with stock history cannot be deleted: operations are permanent records."
                   Style="{StaticResource CaptionLabel}" IsVisible="{Binding CanManageProducts}" />
        </VerticalStackLayout>

        <FlexLayout Grid.Row="5" Wrap="Wrap">
            <Button StyleClass="Primary" Text="Add product" Command="{Binding AddProductCommand}"
                    IsVisible="{Binding CanAddProduct}" Margin="0,0,10,6" AutomationId="AddProductButton" />
            <Button StyleClass="Outlined" Text="Characteristics" Command="{Binding OpenCharacteristicsCommand}"
                    IsVisible="{Binding CanManageCharacteristics}" Margin="0,0,10,6" />
            <Button StyleClass="Outlined" Text="Scan" Command="{Binding ScanCommand}" Margin="0,0,10,6" AutomationId="ScanButton" />
            <Button StyleClass="Outlined" Text="Map" Command="{Binding OpenMapCommand}" Margin="0,0,10,6" AutomationId="MapButton" />
        </FlexLayout>
    </Grid>
</ContentPage>
