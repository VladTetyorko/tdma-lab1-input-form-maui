<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             xmlns:models="clr-namespace:Mobile_apps_L1_Model_view.Models;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.CharacteristicsPage"
             x:DataType="viewModels:CharacteristicsViewModel"
             Title="Characteristics">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="Container">
        <components:AppBar Title="Characteristics" BackCommand="{Binding GoBackCommand}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{OnIdiom Default='24,8', Phone='16,8'}" Spacing="16" MaximumWidthRequest="720">
                <Border StyleClass="SectionCard">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Characteristic">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Name}" Style="{StaticResource TextBodyStrong}" />
                                    <Label Grid.Column="1" Text="{Binding ValueType}" Style="{StaticResource TextCaption}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding CanManage}" Spacing="8">
                    <components:OutlinedField Label="New characteristic" Placeholder="Name" EntryId="CharacteristicNameEntry"
                                              Text="{Binding NewName, Mode=TwoWay}" ErrorText="{Binding NameError}" />
                    <!-- Two chips of equal width; the chosen one is filled and says so to a screen reader -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="{Binding TextChip}" StyleClass="Outlined" AutomationId="TextTypeButton"
                                Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static models:CharacteristicValueType.Text}" />
                        <Button Grid.Column="1" Text="{Binding NumberChip}" StyleClass="Outlined" AutomationId="NumberTypeButton"
                                Command="{Binding SelectTypeCommand}" CommandParameter="{x:Static models:CharacteristicValueType.Number}" />
                    </Grid>
                    <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <components:BottomActionBar Grid.Row="2" ButtonId="AddCharacteristicButton" Text="Add characteristic"
                                    Command="{Binding AddCommand}" IsVisible="{Binding CanManage}" />
    </Grid>
</ContentPage>
