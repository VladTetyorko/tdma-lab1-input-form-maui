<?xml version="1.0" encoding="utf-8"?>

<!-- A list and one action; the form of a new characteristic is a sheet -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Mobile_apps_L1_Model_view.Views"
             xmlns:components="clr-namespace:Mobile_apps_L1_Model_view.Views.Components"
             xmlns:viewModels="clr-namespace:Mobile_apps_L1_Model_view.ViewModels;assembly=StockRoom.Core"
             xmlns:models="clr-namespace:Mobile_apps_L1_Model_view.Models;assembly=StockRoom.Core"
             x:Class="Mobile_apps_L1_Model_view.Views.CharacteristicsPage"
             x:DataType="viewModels:CharacteristicsViewModel"
             Title="Characteristics">

    <ContentPage.Behaviors>
        <views:PageLifecycleBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="Container, Container, Container, All">
        <components:AppBar Title="Characteristics" BackCommand="{Binding GoBackCommand}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{OnIdiom Default='24,8', Phone='16,8'}" Spacing="8" MaximumWidthRequest="720">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Characteristic">
                            <Grid RowDefinitions="Auto,1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,0" MinimumHeightRequest="56">
                                    <Label Text="{Binding Name}" Style="{StaticResource TextBodyStrong}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding ValueType}" Style="{StaticResource TextCaption}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <BoxView Grid.Row="1" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorLabel}" />
            </VerticalStackLayout>
        </ScrollView>
        <components:BottomActionBar Grid.Row="2" ButtonId="AddCharacteristicButton" Text="+ New characteristic"
                                    Command="{Binding NewCommand}" IsVisible="{Binding CanManage}" />
    </Grid>
</ContentPage>
