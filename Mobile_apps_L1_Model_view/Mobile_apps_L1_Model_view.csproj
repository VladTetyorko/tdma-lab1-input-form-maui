<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
        The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
        When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
        The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
        either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>Mobile_apps_L1_Model_view</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>StockRoom</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.mobile_apps_l1_model_view</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <!-- Android 6.0: the biometric plugin's AndroidX libraries need it (it was 21) -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- Android Release: no trimming, no AOT, no marshal methods. Trimming makes restore ask for Microsoft.NETCore.App.Runtime.Mono.win-x64,
         which nuget.org does not publish for .NET 10, so a Release build and an APK could not be produced at all.
         The cost is a larger, slower-starting package, which is fine for a debug-signed course APK -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PublishTrimmed>false</PublishTrimmed>
        <RunAOTCompilation>false</RunAOTCompilation>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <!-- dotnet publish builds every architecture; the marshal-method classifiers then differ between them
             (XAGJS7009) with this SDK. Off = the classic, slightly slower JNI registration -->
        <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F7A3A" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F7A3A" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

        <!-- Untracked local settings (Sentry DSN): packaged only when the file exists -->
        <MauiAsset Include="appsettings.local.json" LogicalName="appsettings.local.json" Condition="Exists('appsettings.local.json')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <!-- Fingerprint / face / Windows Hello behind IBiometricAuthenticator (MIT) -->
        <PackageReference Include="Plugin.Maui.Biometric" Version="0.1.2" />
        <PackageReference Include="Sentry" Version="7.0.1" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="11.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <!-- Models, services, SQLite data layer and ViewModels (CommunityToolkit.Mvvm, sqlite-net-pcl come with it) -->
    <ItemGroup>
        <ProjectReference Include="..\StockRoom.Core\StockRoom.Core.csproj" />
    </ItemGroup>

    <!-- The bundle's native sqlite3 (2.1.11) has a known vulnerability (GHSA-2m69-gcr7-jv3q); 2.1.14 fixes it.
         Android has its own native package, the other platforms share the desktop one -->
    <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.14" />
    </ItemGroup>
    <ItemGroup Condition="!$(TargetFramework.StartsWith('net10.0-android'))">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    </ItemGroup>

    <!-- Camera barcode scanning and the embedded Map control exist on Android and iOS only; Windows uses manual entry
         and the list with "Open in maps" -->
    <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android')) or $(TargetFramework.StartsWith('net10.0-ios'))">
        <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
        <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
    </ItemGroup>

</Project>
